PORT=3000
TZ=Europe/Oslo

# --- Proaktive briefinger ---
MORNING_BRIEFING_ENABLED=true
MORNING_BRIEFING_HOUR=7
MORNING_BRIEFING_MINUTE=0
WEEKLY_BRIEFING_ENABLED=false
WEEKLY_BRIEFING_WEEKDAY=6
WEEKLY_BRIEFING_HOUR=18
WEEKLY_BRIEFING_MINUTE=0

# --- Chat / Intervals write ---
COACH_WEEK_OVERRIDE=
SESSION_MAX_TURNS=10
ADMIN_BRIEFING_SECRET=
INTERVALS_MAX_BULK_EVENTS=14

# --- Atlas + GitHub-synk (påkrevd på Fly) ---
